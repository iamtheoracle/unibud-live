# Copy to .env. Generate a long random key; never commit the real value.
ORACLE_ARC_API_KEY=replace-with-a-long-random-secret
# Must exactly match the authenticated platform user's stable ID.
ORACLE_ARC_OWNER_ID=replace-with-your-user-id
ORACLE_ARC_MODEL=qwen2.5:7b
ORACLE_ARC_ALLOWED_TOOLS=memory.search,memory.save,memory.delete
