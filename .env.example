# UNIBUD environment contract
# Copy to .env.local for local development. Never commit real secrets.

# Authentication
VITE_AUTH_ENABLED=false
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=

# Production federated authentication
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Production Postgres
# DATABASE_URL is preferred. Netlify Database may provide NETLIFY_DB_URL.
DATABASE_URL=
NETLIFY_DB_URL=
NETLIFY_DATABASE_URL=
NETLIFY_DATABASE_URL_UNPOOLED=

# Personal Oracle Arc local model service (server-only; never prefix with VITE_)
# All three values must be configured together. Owner ID must match the authenticated user ID.
ORACLE_ARC_URL=
ORACLE_ARC_API_KEY=
ORACLE_ARC_OWNER_ID=

# Other AI providers are used only when Oracle Arc is not configured.
XAI_API_KEY=
OPENAI_API_KEY=
