# UNIBUD environment contract
# Copy to .env.local for local development. Never commit real secrets.

# Authentication
VITE_AUTH_ENABLED=false
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=

# Production federated authentication
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Production Postgres
# DATABASE_URL is preferred. Netlify Database may provide NETLIFY_DB_URL.
DATABASE_URL=
NETLIFY_DB_URL=
NETLIFY_DATABASE_URL=
NETLIFY_DATABASE_URL_UNPOOLED=

# AI providers (server-only — never prefix with VITE_)
XAI_API_KEY=
OPENAI_API_KEY=

# Durable media object storage (required for production media uploads)
# S3-compatible storage such as Cloudflare R2 or AWS S3.
# Use the account endpoint, not a public bucket URL. Keep credentials server-only.
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Optional local development storage directory (ignored when object storage is configured)
MEDIA_STORAGE_DIR=

# Optional analytics. GA4 is loaded only after visitor consent; no ID is invented.
VITE_GA_MEASUREMENT_ID=
# Server-to-server credential used by The Arc Space analytics bridge. Never prefix with VITE_.
UNIBUD_ANALYTICS_API_KEY=
# Optional comma-separated user IDs permitted to call the in-app summary function.
UNIBUD_ANALYTICS_ADMIN_IDS=
